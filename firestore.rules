rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each authenticated user has access to their own shop data and subcollections
    match /shops/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
